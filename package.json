{
    "name": "smart-cpmpr",
    "displayName": "Smart",
    "description": "Adds syntax highlighting for the Smart language",
    "version": "0.0.5",
    "publisher": "smartin187",
    "icon": "images/logo_smart.png",

    "main": "./out/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/smartin187/smart_smartykit_vscode_extension-cpmpr"
    },
    "engines": {
        "vscode": "^1.118.0"
    },
    "activationEvents": [
        "onLanguage:smart"
    ],
    "categories": [
        "Programming Languages"
    ],
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile",
        "package": "vsce package --no-rewrite-relative-links --allow-missing-repository"
    },
    "devDependencies": {
        "@types/node": "^20.19.41",
        "@types/vscode": "^1.118.0",
        "typescript": "^5.0.0"
    },
    "files": [
        "out",
        "images",
        "snippets",
        "syntaxes",
        "language-configuration.json"
    ],
    "contributes": {
        "languages": [
            {
                "id": "smart",
                "aliases": [
                    "Smart",
                    "smart"
                ],
                "extensions": [
                    ".sma"
                ],
                "icon": {
                    "light": "./images/logo_smart.png",
                    "dark": "./images/logo_smart.png"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "smart",
                "scopeName": "source.smart",
                "path": "./syntaxes/smart.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "smart",
                "path": "./snippets/smart.json"
            }
        ],
        "commands": [
            {
                "command": "smart.run",
                "title": "Run the Smart program",
                "icon": "$(run)"
            },
            {
                "command": "smart.build",
                "title": "Build the Smart program",
                "icon": "$(tools)"
            }
        ],
        "keybindings": [
            {
                "command": "smart.run",
                "key": "ctrl+f5",
                "when": "editorLangId == smart"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "smart.run",
                    "group": "navigation",
                    "when": "resourceLangId == smart"
                },
                {
                    "command": "smart.build",
                    "group": "navigation",
                    "when": "resourceLangId == smart"
                }
            ]
        },
        "configuration": {
            "title": "Smart",
            "properties": {
                "smart.emulatorPath": {
                    "type": "string",
                    "default": "",
                    "description": "Full path to smart_emulator (Linux: /usr/bin/smart_emulator or Windows: smart_emulator.exe). Leave empty to use default paths (/usr/bin/smart_emulator on Linux, %LOCALAPPDATA%\\Smart-SmartyKit\\smart_emulator.exe on Windows) then auto-detection in the workspace."
                },
                "smart.compilerPath": {
                    "type": "string",
                    "default": "",
                    "description": "Full path to smart_build (Linux: /usr/bin/smart_build or Windows: smart_build.exe). Leave empty to use default paths (/usr/bin/smart_build on Linux, %LOCALAPPDATA%\\Smart-SmartyKit\\smart_build.exe on Windows) then auto-detection in the workspace."
                },
                "smart.toolchainPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to a folder containing smart_emulator and/or smart_build (on Linux) or smart_emulator.exe and/or smart_build.exe (on Windows). Leave empty for auto-detection in the workspace."
                }
            }
        },
        "semanticTokenTypes": [
            {
                "id": "anchor",
                "description": "Smart anchor symbol"
            }
        ]
    }
}
