{
    "comments": {
        "lineComment": {
        "comment": "//",
        "noIndent": false 
    }
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["\"", "\""],
        ["'", "'"],
        ["F\"", "\""]
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["\"", "\""],
        ["'", "'"]
    ],

    "onEnterRules": [
        {
            "beforeText": "\\{;\\s*$",
            "action": {
                "indent": "indent"
            }
        },
        {
            "beforeText": "^\\s*}",
            "action": {
                "indent": "outdent"
            }
        }
    ]
}