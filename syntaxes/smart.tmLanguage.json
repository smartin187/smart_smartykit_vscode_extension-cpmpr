{
    "name": "Smart",
    "patterns": [
        {
            "include": "#anchorDefinition"
        },
        {
            "include": "#anchorReference"
        },
        {
            "include": "#ifStatement"
        },
        {
            "include": "#whileStatement"
        },
        {
            "include": "#classDeclaration"
        },
        {
            "include": "#classReference"
        },
        {
            "include": "#functionDeclaration"
        },
        {
            "include": "#functionCall"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#booleans"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#builtins"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#importStatement"
        }
    ],
    "repository": {
        "anchorDefinition": {
            "patterns": [
                {
                    "name": "meta.anchor.smart",
                    "match": "^\\s*(#)([a-zA-Z_][a-zA-Z0-9_]*)\\s*;",
                    "captures": {
                        "1": {"name": "punctuation.definition.anchor.smart"},
                        "2": {"name": "entity.name.label.smart"}
                    }
                },
                {
                    "name": "punctuation.definition.anchor.smart",
                    "match": "#",
                    "captures": {
                        "1": {"name": "punctuation.definition.anchor.smart"},
                        "2": {"name": "entity.name.label.smart"}
                    }
                }
            ]
        },
        "anchorReference": {
            "patterns": [{
                "name": "meta.anchor-reference.smart",
                "match": "(goto)\\s*:\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
                "captures": {
                    "1": {"name": "support.function.builtin.smart"},
                    "2": {"name": "variable.other.label.smart"}
                }
            }]
        },
        "ifStatement": {
            "patterns": [{
                "name": "meta.if-statement.smart",
                "begin": "\\b(if)\\b",
                "end": "\\{",
                "beginCaptures": {
                    "1": {"name": "keyword.control.smart"}
                },
                "endCaptures": {
                    "0": {"name": "punctuation.definition.block.smart"}
                },
                "patterns": [
                    {"include": "#functionCall"},
                    {"include": "#numbers"},
                    {"include": "#strings"},
                    {"include": "#comments"},
                    {"include": "#variables"},
                    {"include": "#booleans"},
                    {"include": "#keywords"},
                    {"include": "#builtins"}
                ]
            }]
        },
        "whileStatement": {
            "patterns": [{
                "name": "meta.while-statement.smart",
                "begin": "\\b(while)\\b",
                "beginCaptures": {
                    "1": {"name": "keyword.control.smart"}
                },
                "endCaptures": {
                    "0": {"name": "punctuation.definition.block.smart"}
                },
                "patterns": [
                    {"include": "#functionCall"},
                    {"include": "#numbers"},
                    {"include": "#strings"},
                    {"include": "#comments"},
                    {"include": "#variables"},
                    {"include": "#booleans"},
                    {"include": "#keywords"},
                    {"include": "#builtins"}
                ]
            }]
        },
        "importStatement": {
            "patterns": [{
                "name": "meta.import.smart",
                "match": "\\b(import|from)\\b\\s+\\\".\\\"\\s+(from)?\\s*([\"'])([^\"']+)([\"'])?",
                "captures": {
                    "1": {"name": "keyword.control.smart"},
                    "2": {"name": "keyword.control.smart"},
                    "3": {"name": "punctuation.definition.string.begin.smart"},
                    "4": {"name": "string.quoted.smart"},
                    "5": {"name": "punctuation.definition.string.end.smart"}
                }
            }]
        },
        "classReference": {
            "patterns": [{
                "name": "meta.class-reference.smart",
                "match": "\\b(A|X|Y)\\b(?!\\s*\\{)",
                "captures": {
                    "1": {"name": "entity.name.class.smart"}
                }
            }]
        },
        "functionDeclaration": {
            "patterns": [{
                "name": "meta.function.smart",
                "match": "\\b(void)\\s+([\\p{L}_][\\p{L}0-9_]*)\\s*\\{",
                "captures": {
                    "1": {"name": "keyword.control.smart"},
                    "2": {"name": "entity.name.function.smart"}
                }
            }]
        },
        "functionCall": {
            "patterns": [{
                "name": "meta.function-call.smart",
                "match": "\\b([\\p{L}_][\\p{L}0-9_]*)\\s*\\:",
                "captures": {
                    "1": {"name": "entity.name.function.smart"}
                }
            }]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.smart",
                    "match": "\\b0[xX][0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.integer.smart",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "booleans": {
            "patterns": [{
                "name": "constant.language.boolean.smart",
                "match": "\\b(True|False)\\b"
            }]
        },
        "variables": {
            "patterns": [
                {
                    "name": "meta.variable.smart",
                    "match": "\\.([\\p{L}_][\\p{L}0-9_]*)",
                    "captures": {
                        "1": {"name": "variable.other.smart"}
                    }
                },
                {
                    "name": "meta.variable.advanced.smart",
                    "match": "~([\\p{L}_][\\p{L}0-9_]*)",
                    "captures": {
                        "1": {"name": "variable.other.advanced.smart"}
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [{
                "name": "keyword.control.smart",
                "match": "\\b(void|return|import|from|if|else|elif|while|break|continue|error|compiletime\\s+define|compiletime\\s+realloc|compiletime\\s+log|compiletime\\s+debug|compiletime)\\b"
            }]
        },
        "builtins": {
            "patterns": [{
                "name": "support.function.builtin.smart",
                "match": "\\b(print|goto|quit|asm_entry|input|wozm|restart)\\b"
            }]
        },
        "strings": {
            "patterns": [
                {
                    "name": "meta.import.smart",
                    "match": "\\b(import|from)\\b\\s+\"[^\"]*\"(?:\\s+from\\s+\"[^\"]*\")?",
                    "captures": {
                        "1": { "name": "keyword.control.smart" },
                        "2": { "name": "punctuation.definition.string.begin.smart" },
                        "3": { "name": "string.quoted.double.smart" },
                        "4": { "name": "punctuation.definition.string.end.smart" }
                    }

                },
                {
                    "name": "invalid.illegal.string.smart",
                    "match": "(''|'([^'\\\\]|\\\\.){2,}'|'([^'\\\\]|\\\\.)*[a-z]([^'\\\\]|\\\\.)*'|'([^'\\\\]|\\\\.)*$|\"([^\"\\\\]|\\\\.){22,}\"|\"([^\"\\\\]|\\\\.)*[a-z]([^\"\\\\]|\\\\.)*\"|\"([^\"\\\\]|\\\\.)*$)"
                },
                {
                    "name": "string.quoted.double.f.smart",
                    "begin": "(F)(\")",
                    "end": "\"",
                    "beginCaptures": {
                        "1": {"name": "storage.modifier.smart"},
                        "2": {"name": "punctuation.definition.string.begin.smart"}
                    },
                    "endCaptures": {
                        "0": {"name": "punctuation.definition.string.end.smart"}
                    },
                    "patterns": [
                        {"name": "constant.character.escape.smart", "match": "\\\\."},
                        {
                            "name": "meta.embedded.expression.smart",
                            "begin": "\\{",
                            "end": "\\}",
                            "beginCaptures": {
                                "0": {"name": "punctuation.definition.interpolation.begin.smart"}
                            },
                            "endCaptures": {
                                "0": {"name": "punctuation.definition.interpolation.end.smart"}
                            },
                            "patterns": [
                                {"include": "#variables"},
                                {"include": "#functionCall"},
                                {"include": "#numbers"}
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.smart",
                    "begin": "\"",
                    "end": "(\"|\\n)",
                    "endCaptures": {
                        "1": {"name": "meta.string-close.smart"}
                    },
                    "patterns": [{"name": "constant.character.escape.smart", "match": "\\\\."}]
                },
                {
                    "name": "string.quoted.single.smart",
                    "match": "'([^'a-z\\\\]|\\\\.)+'"
                }
            ]
        },
        "comments": {
            "name": "comment.line.double-slash.smart",
            "match": "//.*$"
        }
    },
    "scopeName": "source.smart"
}