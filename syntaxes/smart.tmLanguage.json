{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Smart",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#builtins"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comments"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.smart",
				"match": "\\b(void)\\b"
			}]
		},
		"builtins": {
			"patterns": [{
				"name": "support.function.builtin.smart",
				"match": "\\b(print|goto|quit)\\b"
			}]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.smart",
					"begin": "\"",
					"end": "\"",
					"patterns": [{"name": "constant.character.escape.smart", "match": "\\\\."}]
				},
				{
					"name": "string.quoted.single.smart",
					"begin": "'",
					"end": "'",
					"patterns": [{"name": "constant.character.escape.smart", "match": "\\\\."}]
				}
			]
		},
		"comments": {
			"name": "comment.line.double-slash.smart",
			"match": "//.*$"
		}
	},
	"scopeName": "source.smart"
}